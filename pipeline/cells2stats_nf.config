/*
 * -------------------------------------------------
 *  cells2stats-nf custom profile Nextflow config file
 * -------------------------------------------------
 * Pipeline-specific institutional or environment profiles.
 * Cluster/cloud-specific overrides go in conf/pipeline/cells2stats-nf/
 * and are loaded under a profile name here.
 */

profiles {
    ElembioCloud {
        includeConfig "${params.custom_config_base}/conf/pipeline/cells2stats-nf/ElembioCloud.config"
    }
}
