/*
 * -------------------------------------------------
 *  bases2fastq-nf custom profile Nextflow config file
 * -------------------------------------------------
 * Pipeline-specific institutional or environment profiles.
 * Cluster/cloud-specific overrides go in conf/pipeline/bases2fastq-nf/
 * and are loaded under a profile name here.
 */

profiles {
    ElembioCloud {
        includeConfig "${params.custom_config_base}/conf/pipeline/bases2fastq-nf/ElembioCloud.config"
    }
}
