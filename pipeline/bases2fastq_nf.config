/*
 * bases2fastq-nf pipeline-specific profiles
 */

profiles {
    ElembioCloud {
        params {
            config_profile_name        = 'ElembioCloud'
            config_profile_description = 'ElembioCloud config'

            max_cpus   = 48
            max_memory = '192.GB'
            max_time   = '8.h'
        }

        process {
            withName: 'BASES2FASTQ' {
                cpus = {
                    def cpu_list = [48, 24, 12]
                    return task.attempt <= cpu_list.size() ? cpu_list[task.attempt - 1] : 12
                }
                memory     = { check_max(186.GB, 'memory') }
                disk       = 900.GB
                time       = { check_max( 3.h * task.attempt, 'time') }
                maxRetries = 2
            }
        }

        cleanup = true

        aws {
            batch {
                cliPath             = '/home/ec2-user/miniconda/bin/aws'
                maxParallelTransfers = 48
                maxTransferAttempts  = 3
            }
            client {
                maxConnections   = 48
                uploadMaxThreads = 48
                maxErrorRetry    = 3
                uploadRetrySleep = 100
                uploadChunkSize  = 32.MB
            }
        }
    }
}
