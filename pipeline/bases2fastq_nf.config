/*
 * bases2fastq-nf pipeline-specific profiles
 */

profiles {
    ElembioCloud {
        params {
            config_profile_name        = 'ElembioCloud'
            config_profile_description = 'ElembioCloud config'

            max_cpus   = 48
            max_memory = '384.GB'
            max_time   = '8.h'
        }

        process {
            withName: 'BASES2FASTQ' {
                // Restated here because a withName block inside an active
                // profile replaces, not merges with, the same selector from
                // the pipeline's conf/base.config.
                scratch    = true
                cpus = {
                    def cpu_list = [46, 36, 24] // 46 leaves ECS overhead on a 48-vCPU box
                    return task.attempt <= cpu_list.size() ? cpu_list[task.attempt - 1] : 12
                }
                memory     = { check_max(346.GB, 'memory') } // r5.12xlarge class
                disk       = 900.GB
                time       = { check_max( 2.h * task.attempt, 'time') }
                maxRetries = 4
            }
        }

        cleanup = true

        aws {
            batch {
                cliPath             = '/home/ec2-user/miniconda/bin/aws'
                maxParallelTransfers = 48
                maxTransferAttempts  = 3
            }
            client {
                maxConnections   = 48
                uploadMaxThreads = 48
                maxErrorRetry    = 3
                uploadRetrySleep = 100
                uploadChunkSize  = 32.MB
            }
        }
    }
}
