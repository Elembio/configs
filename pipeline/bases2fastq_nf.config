/*
 * bases2fastq-nf pipeline-specific profiles
 */

profiles {
    ElembioCloud {
        params {
            config_profile_name        = 'ElembioCloud'
            config_profile_description = 'ElembioCloud config'
        }

        process {
            withName: BASES2FASTQ {
                cpus       = 46
                memory     = 186.GB
                disk       = 900.GB
                time       = 3.h
                maxRetries = 2
            }
        }

        cleanup = true

        aws {
            batch {
                cliPath             = '/home/ec2-user/miniconda/bin/aws'
                maxParallelTransfers = 48
                maxTransferAttempts  = 3
            }
            client {
                maxConnections   = 48
                uploadMaxThreads = 48
                maxErrorRetry    = 3
                uploadRetrySleep = 100
                uploadChunkSize  = 32.MB
            }
        }
    }
}
