/*
 * Shared Elembio Cloud settings for all workflows.
 * Pipeline-specific EBC overlays live under
 * conf/pipeline/<repo>/ElembioCloud.config and are applied by the same
 * -profile ElembioCloud (nf-core institution + overlay pattern).
 */
params {
    config_profile_name        = 'ElembioCloud'
    config_profile_description = 'Elembio Cloud (AWS Batch)'
    config_profile_contact     = 'Elembio Bioinformatics'
    config_profile_url         = 'https://www.elembio.com'
}

cleanup = true

aws {
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
    }
    region = 'us-west-2'
}
