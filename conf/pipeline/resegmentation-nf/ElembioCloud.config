/*
 * -------------------------------------------------
 *  resegmentation-nf / ElembioCloud
 * -------------------------------------------------
 * Pipeline overlay for Elembio Cloud. Applied when -profile ElembioCloud
 * is active, via pipeline/resegmentation_nf.config. Plain content (no nested
 * profiles{}): the wrapper lives in the router / nfcore_custom.
 * RESEGMENTATION runs Cellpose on one GPU of the ebc-ondemand-gpu compute
 * environment (g5/g6.12xlarge: 48 vCPU, 192 GB, 4 GPUs).
 */

params {
    config_profile_description = 'ElembioCloud / resegmentation-nf'
}

process {
    withName: 'RESEGMENTATION' {
        queue       = 'ebc-ondemand-gpu'
        accelerator = 1
        cpus        = { 8     * task.attempt }
        memory      = { 32.GB * task.attempt }
        time        = { 12.h  * task.attempt }
        maxRetries  = 1
    }
}
