/*
 * -------------------------------------------------
 *  bases2fastq-nf / ElembioCloud
 * -------------------------------------------------
 * Pipeline overlay for Elembio Cloud. Applied when -profile ElembioCloud
 * is active, via pipeline/bases2fastq_nf.config. Plain content (no nested
 * profiles{}): the wrapper lives in the router / nfcore_custom.
 * Resource values assume the ebc-ondemand-cpu compute environment.
 */

params {
    config_profile_description = 'ElembioCloud / bases2fastq-nf'

    max_cpus   = 48
    max_memory = '384.GB'
    max_time   = '10.h'
}

process {
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration,
    ]

    withName: 'BASES2FASTQ' {
        // Restated here because a withName block inside an active profile
        // replaces, not merges with, the same selector from the pipeline's
        // conf/base.config.
        queue      = 'ebc-ondemand-cpu'
        scratch    = true
        cpus = {
            def cpu_list = [46, 36, 24] // 46 leaves ECS overhead on a 48-vCPU box
            return task.attempt <= cpu_list.size() ? cpu_list[task.attempt - 1] : 12
        }
        memory     = 346.GB // r5.12xlarge class
        disk       = 900.GB
        time       = { 2.h * task.attempt }
        maxRetries = 4
    }

    withName: 'MULTIQC' {
        queue = 'ebc-spot-cpu'
    }
}

aws {
    batch {
        maxParallelTransfers = 48
        maxTransferAttempts  = 3
    }
    client {
        maxConnections   = 48
        uploadMaxThreads = 48
        maxErrorRetry    = 3
        uploadRetrySleep = 100
        uploadChunkSize  = 32.MB
    }
}
