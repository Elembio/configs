/*
 * -------------------------------------------------
 *  cells2stats-nf / ElembioCloud
 * -------------------------------------------------
 * Pipeline overlay for Elembio Cloud. Applied when -profile ElembioCloud
 * is active, via pipeline/cells2stats_nf.config. Plain content (no nested
 * profiles{}): the wrapper lives in the router / nfcore_custom.
 * Resource values assume the ebc-ondemand-cpu compute environment.
 */

params {
    config_profile_description = 'ElembioCloud / cells2stats-nf'

    max_cpus   = 48
    max_memory = '192.GB'
    max_time   = '8.h'
}

process {
    resourceLimits = [
        cpus  : params.max_cpus as int,
        memory: params.max_memory as nextflow.util.MemoryUnit,
        time  : params.max_time as nextflow.util.Duration,
    ]

    withName: 'CELLS2STATS' {
        queue = 'ebc-ondemand-cpu'
        cpus = {
            def cpu_list = [48, 24, 12]
            return task.attempt <= cpu_list.size() ? cpu_list[task.attempt - 1] : 12
        }
        memory     = 180.GB
        time       = { 2.h * task.attempt }
        maxRetries = 4
    }

    withName: 'MULTIQC' {
        queue = 'ebc-spot-cpu'
    }
}

aws {
    batch {
        maxParallelTransfers = 16
        maxTransferAttempts  = 6
    }
    client {
        maxConnections   = 16
        uploadMaxThreads = 16
        maxErrorRetry    = 8
        uploadRetrySleep = 200
        uploadChunkSize  = 32.MB
    }
}
