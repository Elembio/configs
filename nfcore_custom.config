profiles {
    elembio_catalyst {
        includeConfig "${params.custom_config_base}/conf/elembio_catalyst.config"
    }
    macro_igenomes {
        includeConfig "${params.custom_config_base}/conf/macro_igenomes.config"
    }

    // Institution profile (nf-core style). Shared EBC settings for all workflows.
    // Pipeline-specific overlays are registered by pipeline/<name>.config under
    // the same profile name and apply when -profile ElembioCloud is selected.
    ElembioCloud {
        includeConfig "${params.custom_config_base}/conf/ElembioCloud.config"
    }

    // Pipeline-global stubs. EBC queues/resources moved into
    // conf/pipeline/<repo>/ElembioCloud.config. Kept so existing launch strings
    // that still pass these names remain valid; use later for non-EBC globals.
    bases2fastq_nf {
        includeConfig "${params.custom_config_base}/conf/bases2fastq_nf.config"
    }
    cells2stats_nf {
        includeConfig "${params.custom_config_base}/conf/cells2stats_nf.config"
    }
    sentieon_cli_nf {
        includeConfig "${params.custom_config_base}/conf/sentieon_cli_nf.config"
    }
    parabricks_nextflow {
        includeConfig "${params.custom_config_base}/conf/parabricks_nextflow.config"
    }
    elembio_tetonatlas_nf {
        includeConfig "${params.custom_config_base}/conf/elembio_tetonatlas_nf.config"
    }
}
